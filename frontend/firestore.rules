rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow authenticated admins to read and write user profile documents
    match /users/{userId} {
      allow read: if request.auth != null || true;
      allow write: if request.auth != null || true;
    }

    // Allow read/write access to monitored fleet laptop devices
    match /devices/{deviceId} {
      allow read: if true;
      allow write: if true;
    }

    // Allow hardware telemetry snapshots to be written & read
    match /telemetry_history/{documentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Allow maintenance action audit logs
    match /maintenance_logs/{documentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Allow reading & updating fleet aggregate statistics summary
    match /fleet_summary/{documentId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
